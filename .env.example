# Copy to .env and fill in your own values. Never commit .env.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# development | test | production   (defaults to production, the safest)
GLOZ_ENV=development

# Required. At least 32 random characters.
SECRET_KEY=

# Required. At least 16 random characters, different from SECRET_KEY.
# Used to pseudonymize IP addresses in the security log.
IP_HASH_SALT=

# Optional
# DATABASE_PATH=instance/gloz.sqlite3
# LOG_DIR=logs
# SESSION_HOURS=12
# Comma-separated IPs of your reverse proxy (e.g. 127.0.0.1). Leave empty without a proxy.
# TRUSTED_PROXIES=
